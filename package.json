{
  "name": "dungeon-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "build": "vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test:game": "tsx --test packages/game/test/*.test.ts",
    "test:web": "tsx --test apps/web/test/*.test.ts",
    "test": "npm run test:game",
    "test:contract": "tsx --test --test-concurrency=2 tests/contract/*.test.ts",
    "test:server": "tsx --test --test-concurrency=2 apps/server/test/*.test.ts",
    "test:e2e": "tsx --test apps/server/test/http-loop.test.ts apps/server/test/economy-loop.test.ts",
    "build:contract": "cargo build --manifest-path contracts/economy/Cargo.toml --target wasm32-unknown-unknown --release --locked",
    "verify": "npm run typecheck && npm run build:contract && npm test && npm run test:web && npm run test:contract && npm run test:server && npm run build",
    "server": "tsx apps/server/src/main.ts",
    "sandbox": "tsx scripts/demo-sandbox.ts",
    "sim:depth": "tsx scripts/depth-sim.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@near-wallet-selector/nightly": "10.1.4",
    "buffer": "6.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "near-api-js": "7.4.0",
    "near-sandbox": "0.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "overrides": {
    "near-sandbox": {
      "tar": "7.5.22"
    }
  }
}
