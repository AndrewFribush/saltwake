{
  "name": "dungeon-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "build": "vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test:game": "tsx --test packages/game/test/*.test.ts",
    "test": "npm run test:game",
    "test:contract": "tsx --test tests/contract/*.test.ts",
    "test:server": "node scripts/not-ready.mjs server",
    "test:e2e": "node scripts/not-ready.mjs e2e",
    "build:contract": "cargo build --manifest-path contracts/economy/Cargo.toml --target wasm32-unknown-unknown --release --locked"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "near-api-js": "7.4.0",
    "near-sandbox": "0.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "overrides": {
    "near-sandbox": {
      "tar": "7.5.22"
    }
  }
}
